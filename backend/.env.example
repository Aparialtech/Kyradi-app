NODE_ENV=development  # required
PORT=3000  # required

# MongoDB connection
MONGODB_URI=mongodb://kyradi:kyradi_dev_password@localhost:27017/kyradi?authSource=admin  # required

# Auth
JWT_SECRET=change_me_super_secret  # required (SECRET)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com  # optional (used for social login verify)
APPLE_AUDIENCE=com.kyradi.app  # optional (used for Apple login verify)

# Firebase Admin (optional)
FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"kyradi","client_email":"x","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}  # optional (SECRET)
FIREBASE_PROJECT_ID=kyradi  # optional

# Mail (choose provider)
MAIL_PROVIDER=resend  # optional (resend|smtp)
MAIL_FROM=KYRADI <no-reply@kyradi.com>  # optional
RESEND_API_KEY=your_resend_api_key  # optional (SECRET)

MAIL_HOST=smtp.example.com  # optional (SMTP)
MAIL_PORT=465  # optional
MAIL_SECURE=true  # optional
MAIL_USER=mail_user  # optional
MAIL_PASS=mail_password  # optional (SECRET)

# Maps
GOOGLE_DIRECTIONS_API_KEY=your_google_directions_key  # optional/required if /directions is used (SECRET)

# Payment webhook (demo)
MAGICPAY_WEBHOOK_SECRET=your_webhook_secret  # optional (SECRET)
MAGICPAY_CHECKOUT_BASE_URL=https://pay.kyradi.com/checkout  # optional

# Chatbot (optional)
CHAT_PROVIDER=disabled  # optional (openai|gemini|disabled)
CHAT_API_KEY=your_chat_api_key  # optional (SECRET)
CHAT_MODEL=gpt-4o-mini  # optional
CHAT_TIMEOUT_MS=12000  # optional

# Payments demo mode (optional)
PAYMENTS_DEMO_MODE=true  # optional

# Debug flags
EXPOSE_RESET_CODE=false  # optional
EXPOSE_VERIFICATION_CODE=false  # optional

# Build metadata (Railway)
BUILT_AT=2026-01-30T00:00:00Z  # optional
GIT_SHA=local-dev  # optional
RAILWAY_GIT_COMMIT_SHA=railway-commit-sha  # optional
