# Core
NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb://USER:PASS@HOST:PORT/DB_NAME?authSource=admin
JWT_SECRET=change_me

# CORS / Security
CORS_ORIGINS=https://admin.kyradi.com,https://kyradi.com
TRUST_PROXY=1
JSON_BODY_LIMIT_MB=1
VALIDATION_FORBID_NON_WHITELISTED=false
THROTTLE_TTL=60
THROTTLE_LIMIT=60
UPLOAD_MAX_MB=5
UPLOADS_DIR=

# KYC / Identity verification (Profile Onayi)
KYC_ENABLED=false
KYC_REQUIRE_SELFIE=false
KYC_AUTO_APPROVE_IN_DEV=true
KYC_DOC_RETENTION_DAYS=30
KYC_MAX_UPLOAD_MB=5
KYC_OTP_TTL_MIN=10
KYC_OTP_RATE_LIMIT=3

# Admin (manual review MVP)
ADMIN_API_KEY=
ADMIN_PANEL_ENABLED=true

# Auth / Social
GOOGLE_CLIENT_ID=
APPLE_AUDIENCE=com.kyradi.kyradi
FIREBASE_PROJECT_ID=kyradi-superapp
FIREBASE_SERVICE_ACCOUNT_JSON=
PUSH_NOTIFICATIONS_ENABLED=false

# Mail
MAIL_PROVIDER=resend
MAIL_FROM=no-reply@kyradi.com
RESEND_API_KEY=
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=

# Maps
GOOGLE_DIRECTIONS_API_KEY=

# Payments
PAYMENTS_DEMO_MODE=true
MAGICPAY_WEBHOOK_SECRET=

# SaaS Integration
SAAS_BASE_URL=
SAAS_INTEGRATION_SECRET=
SAAS_TIMEOUT_MS=8000
SAAS_RETRY_COUNT=2

# Chat
CHAT_PROVIDER=disabled
CHAT_API_KEY=
CHAT_MODEL=gpt-4o-mini
CHAT_TIMEOUT_MS=12000

# Debug
EXPOSE_RESET_CODE=false
EXPOSE_VERIFICATION_CODE=false
BUILT_AT=
GIT_SHA=
RAILWAY_GIT_COMMIT_SHA=
